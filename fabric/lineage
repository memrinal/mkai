def get_all_pipelines(workspace_id, access_token):
“”“Get all data pipelines in workspace”””
url = f”https://api.fabric.microsoft.com/v1/workspaces/{workspace_id}/items?type=DataPipeline”
headers = {
‘Authorization’: f’Bearer {access_token}’,
‘Content-Type’: ‘application/json’
}

```
response = requests.get(url, headers=headers)
if response.status_code == 200:
    return response.json().get('value', [])
return []
```

def get_pipeline_definition(workspace_id, pipeline_id, access_token):
“”“Get pipeline definition”””
url = f”https://api.fabric.microsoft.com/v1/workspaces/{workspace_id}/items/{pipeline_id}/getDefinition”
headers = {
‘Authorization’: f’Bearer {access_token}’,
‘Content-Type’: ‘application/json’
}

```
response = requests.post(url, headers=headers)
if response.status_code == 200:
    return response.json()
return {}
```

def extract_pipeline_lineage(pipeline_def, pipeline_name):
“”“Extract lineage from pipeline definition”””
lineage_records = []

```
# Parse pipeline JSON
definition_parts = pipeline_def.get('definition', {}).get('parts', [])

for part in definition_parts:
    if part.get('path') == 'pipeline-content.json':
        payload = part.get('payload')
        if payload:
            pipeline_content = json.loads(payload)
            activities = pipeline_content.get('properties', {}).get('activities', [])
            
            for activity in activities:
                record = extract_activity_lineage(activity, pipeline_name)
                if record:
                    lineage_records.append(record)

return lineage_records
```

def extract_activity_lineage(activity, pipeline_name):
“”“Extract lineage from individual activity”””
activity_type = activity.get(‘type’)
activity_name = activity.get(‘name’)

```
record = {
    'pipeline_name': pipeline_name,
    'activity_name': activity_name,
    'activity_type': activity_type,
    'source': '',
    'source_type': '',
    'target': '',
    'target_type': '',
    'transformation': '',
    'timestamp': datetime.now().isoformat()
}

# Copy Data Activity
if activity_type == 'Copy':
    source = activity.get('typeProperties', {}).get('source', {})
    sink = activity.get('typeProperties', {}).get('sink', {})
    
    record['source_type'] = source.get('type', '')
    record['target_type'] = sink.get('type', '')
    
    # Get source details
    inputs = activity.get('inputs', [])
    if inputs:
        record['source'] = inputs[0].get('referenceName', '')
    
    # Get target details
    outputs = activity.get('outputs', [])
    if outputs:
        record['target'] = outputs[0].get('referenceName', '')
    
    # Get query/table info
    if 'query' in source:
        record['transformation'] = f"Query: {source.get('query')}"
    if 'table' in source:
        record['source'] += f".{source.get('table')}"
    if 'table' in sink:
        record['target'] += f".{sink.get('table')}"

# Notebook Activity
elif activity_type in ['SynapseNotebook', 'DatabricksNotebook']:
    type_props = activity.get('typeProperties', {})
    notebook = type_props.get('notebook', {})
    record['source'] = notebook.get('referenceName', 'Unknown Notebook')
    record['source_type'] = 'Notebook'
    
    # Extract parameters
    params = type_props.get('parameters', {})
    param_str = ', '.join([f"{k}={v.get('value')}" for k, v in params.items()])
    record['transformation'] = f"Parameters: {param_str}"

# Dataflow Activity
elif activity_type == 'ExecuteDataFlow':
    type_props = activity.get('typeProperties', {})
    dataflow = type_props.get('dataflow', {})
    record['source'] = dataflow.get('referenceName', 'Unknown Dataflow')
    record['source_type'] = 'Dataflow'

return record
```

