# Create a simple lineage graph structure

def create_lineage_graph(df):
“”“Create lineage graph structure”””
graph = {
‘nodes’: [],
‘edges’: []
}

```
node_ids = set()

for _, row in df.iterrows():
    # Add source node
    if row['source'] and row['source'] not in node_ids:
        graph['nodes'].append({
            'id': row['source'],
            'type': row['source_type'],
            'label': row['source']
        })
        node_ids.add(row['source'])
    
    # Add target node
    if row['target'] and row['target'] not in node_ids:
        graph['nodes'].append({
            'id': row['target'],
            'type': row['target_type'],
            'label': row['target']
        })
        node_ids.add(row['target'])
    
    # Add edge
    if row['source'] and row['target']:
        graph['edges'].append({
            'from': row['source'],
            'to': row['target'],
            'pipeline': row['pipeline_name'],
            'activity': row['activity_name']
        })

return graph
```

lineage_graph = create_lineage_graph(lineage_df)

print(f”\nLineage graph created:”)
print(f”  - Nodes: {len(lineage_graph[‘nodes’])}”)
print(f”  - Edges: {len(lineage_graph[‘edges’])}”)

# Save graph

with open(‘fabric_lineage_graph.json’, ‘w’) as f:
json.dump(lineage_graph, f, indent=2)
print(“✓ Exported graph to fabric_lineage_graph.json”)

